{
  "name": "dev-lock",
  "version": "0.0.0",
  "private": true,
  "description": "Global lock on the shared dev environment (PLAT-473). A JavaScript action, so GitHub has nothing to build or pull.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\""
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1148.0",
    "@aws-sdk/lib-dynamodb": "3.1148.0"
  },
  "devDependencies": {
    "dynalite": "4.0.0",
    "esbuild": "0.28.2"
  },
  "type": "module"
}
